{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardianDecision",
  "type": "object",
  "required": ["decision_id", "policy_version", "approved", "rules_applied", "reasoning", "local_execution_confirmed"],
  "properties": {
    "decision_id": {"type": "string"},
    "file_id": {"type": "string"},
    "policy_version": {"type": "string"},
    "approved": {"type": "boolean"},
    "approved_actions": {"type": "array", "items": {"type": "string"}},
    "rules_applied": {"type": "array", "items": {"type": "string"}},
    "reasoning": {"type": "string"},
    "human_review_required": {"type": "boolean"},
    "local_execution_confirmed": {"type": "boolean"}
  },
  "additionalProperties": true
}
